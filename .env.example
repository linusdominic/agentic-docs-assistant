# Copy to .env and fill in. The .env file is git-ignored.

# Key for the model provider named in LLM_MODEL.
ANTHROPIC_API_KEY=

# Any LangChain chat model string, "provider:model".
LLM_MODEL=anthropic:claude-opus-5-5

# Local PostgreSQL started by `make db`.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/docs_agent

# Optional. When set, /chat requests must send it in the X-API-Key header.
# API_KEY=
